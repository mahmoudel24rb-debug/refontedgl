# -----------------------------------------------------------------------------
# Payload
# -----------------------------------------------------------------------------
PAYLOAD_SECRET=

# -----------------------------------------------------------------------------
# Base de donnees (Neon). DATABASE_URL = chaine pooled, utilisee par l'app.
# DATABASE_URL_UNPOOLED = connexion directe, utilisee pour les migrations.
# En local : pnpm dev:db puis
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/dgl
# -----------------------------------------------------------------------------
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# -----------------------------------------------------------------------------
# Emails (Resend). Sans RESEND_API_KEY, Payload journalise les envois.
# -----------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
ADMIN_EMAIL=contact@dgl-agency.fr

# -----------------------------------------------------------------------------
# Stockage des medias (Vercel Blob). Sans jeton, stockage disque local.
# -----------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=

# -----------------------------------------------------------------------------
# Outils : APIs externes
# -----------------------------------------------------------------------------
GOOGLE_PSI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
# Scan de visibilite IA sans reseau : moteurs factices (jamais en production).
# Actifs aussi en developpement quand les deux cles ci-dessus sont absentes.
GEOSCAN_FAKE=
# Duree simulee d'un appel factice, en millisecondes (1500 par defaut).
GEOSCAN_FAKE_DELAY_MS=

# -----------------------------------------------------------------------------
# Site public
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://dgl-agency.fr
NEXT_PUBLIC_GTM_ID=
# 1 tant que le site n'est pas sur le domaine definitif.
NEXT_PUBLIC_NOINDEX=1

# -----------------------------------------------------------------------------
# Cron Vercel : purge des runs anonymes de plus de 90 jours
# -----------------------------------------------------------------------------
CRON_SECRET=
